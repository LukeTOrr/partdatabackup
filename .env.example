# Copy to .env and fill in. .env is gitignored; this file is committed.
# launch.js validates REQUIRED_ENV at startup and refuses to run if keys are missing.

JOB_NAME=ProjectName

# Portal credentials (NEVER hardcode these in .js files)
#PORTAL_USER=
#PORTAL_PASS=

# Google service account key — keep the JSON OUTSIDE the project folder
GOOGLE_SA_KEY_FILE=C:\Users\PCUser\.keys\celltech-sa.json

# Target spreadsheet(s)
#SPREADSHEET_ID=

# Fleet heartbeat — same JobLog sheet ID in every project
HEARTBEAT_SHEET_ID=
HEARTBEAT_TAB=JobLog

# true on Cloud Run, false locally (watch the browser)
HEADLESS=false
