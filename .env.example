# Copy to .env and fill in. .env is gitignored; this file is committed.
# launch.js validates REQUIRED_ENV at startup and refuses to run if keys are missing.
# On Cloud Run these come from --set-env-vars in deploy.yml, not this file.

JOB_NAME=scheduler-sunset

PROJECT_ID=celltech-internal-tools
# GCS bucket that holds the schedule snapshots (snapshots/latest.json + dated copies)
SNAPSHOT_BUCKET=celltech-internal-tools-scheduler-snapshots
# This tool's own Cloud Scheduler trigger — never snapshotted or deleted, only paused
SELF_TRIGGER_NAME=scheduler-sunset-trigger

# true = list what would happen, change nothing
DRY_RUN=true

# Restore from a specific snapshot instead of snapshots/latest.json (optional)
#SNAPSHOT_OBJECT=snapshots/2026-09-25T19-00-00-000Z.json

# Google service account key — keep the JSON OUTSIDE the project folder.
# Leave commented out to use your gcloud login locally (gcloud auth application-default login)
# and the job's service account on Cloud Run.
#GOOGLE_SA_KEY_FILE=C:\Users\PCUser\.keys\celltech-sa.json

# Fleet heartbeat — same JobLog sheet ID in every project
HEARTBEAT_SHEET_ID=
HEARTBEAT_TAB=JobLog
